# Optional frontend overrides (Next.js loads .env.local automatically).
# Root .env NEXT_PUBLIC_* values are enough for ./start.sh (it copies them if
# this file is missing).

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_BOOK_ID=FIXTURE_BOOK_001
NEXT_PUBLIC_TENANT_ID=FIXTURE_TENANT_001
