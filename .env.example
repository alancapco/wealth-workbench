# =============================================================================
# Wealth Workbench — environment template
# Copy to .env and fill secrets:  cp .env.example .env
# Compose reads this file automatically for ${POSTGRES_*} / service env.
# Backend also loads ../.env then backend/.env (see app/core/config.py).
# =============================================================================

# --- Runtime / auth ---
# Local and shared demos MUST use fixture mode (OIDC is not wired yet).
APP_ENV=development
ENVIRONMENT=development
AUTH_MODE=fixture
# OIDC (only when AUTH_MODE=oidc — currently unimplemented)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Database (must match docker-compose POSTGRES_* ) ---
POSTGRES_USER=rm_user
POSTGRES_PASSWORD=demo_password_123
POSTGRES_DB=rm_workbench
# Host apps use localhost; Docker backend overrides host to "postgres".
DATABASE_URL=postgresql://rm_user:demo_password_123@localhost:5432/rm_workbench
# Alembic head revision — keeps /health/ready honest after migrations.
EXPECTED_SCHEMA_HEAD=j0urn3y0001

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- App ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
OUTBOX_WORKER_ENABLED=true

# --- Feature flags ---
FAMILY_DEC06_ENABLED=true
HOUSEHOLD_DEC07_ENABLED=true
SHARIAH_DEC05_ENABLED=false
# Portable default: graph features degrade gracefully without Neo4j.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview

# --- Market quotes / history (Alpha Vantage) ---
# https://www.alphavantage.co/support/#api-key
# Free tier: GLOBAL_QUOTE + TIME_SERIES_DAILY. Without this key, quotes/history are empty.
ALPHAVANTAGE_API_KEY=

# --- English news (optional) ---
# newsfilter_yahoo | yahoo | newsfilter
NEWS_PROVIDER=newsfilter_yahoo
NEWSFILTER_API_KEY=
YAHOO_NEWS_DEFAULT_SYMBOLS=^GSPC,^HSI,^STI,HSBC,0700.HK,D05.SI,AAPL
FREECURRENCY_API_KEY=

# --- HubSpot (optional; CRM adapter may be unused in this branch) ---
HUBSPOT_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# --- Shariah / AAOIFI ---
# Use a path that exists on the target machine, or leave /tmp for stub mode.
SHARIAH_TOOLS_PATH=/tmp
AAOIFI_PDF_PATH=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_BOOK_ID=FIXTURE_BOOK_001
NEXT_PUBLIC_TENANT_ID=FIXTURE_TENANT_001
# NEXT_PUBLIC_PRINCIPAL_ID=
