# Database
DATABASE_URL=postgresql://rm_user:your_password_here@localhost:5432/rm_workbench
POSTGRES_USER=rm_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=rm_workbench

# Tiger Broker API (https://www.tigerbrokers.com.sg/)
# Register at: https://www.itiger.com/openapi/info
TIGER_CLIENT_ID=your_tiger_client_id
TIGER_PRIVATE_KEY=your_tiger_private_key_path
TIGER_ACCOUNT=your_tiger_account

# HubSpot (you already have this)
HUBSPOT_API_KEY=your_hubspot_api_key
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token

# AI Services - OpenAI Compatible API
# Works with OpenAI, Anthropic (via proxy), or any OpenAI-compatible endpoint
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview

# Examples for different providers:
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4-turbo-preview
# Anthropic: LLM_BASE_URL=https://api.anthropic.com/v1, LLM_MODEL=claude-3-opus-20240229
# Local: LLM_BASE_URL=http://localhost:8080/v1, LLM_MODEL=your-model

# English market news. newsfilter_yahoo tries Newsfilter v2, then Yahoo Finance RSS.
# yahoo uses only the keyless Yahoo RSS feed. newsfilter never falls back to Yahoo.
# Chinese (zh_CN) still uses Tiger Broker when credentials are configured.
# https://newsfilter.io/docs
NEWSFILTER_API_KEY=your_newsfilter_api_key
NEWS_PROVIDER=newsfilter_yahoo
YAHOO_NEWS_DEFAULT_SYMBOLS=^GSPC,^HSI,^STI,HSBC,0700.HK,D05.SI,AAPL

# Alpha Vantage (https://www.alphavantage.co/documentation/)
# Free keys serve GLOBAL_QUOTE and TIME_SERIES_DAILY. NEWS_SENTIMENT is premium.
ALPHAVANTAGE_API_KEY=your_alphavantage_key

# Application Settings
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Shariah Tools Path
SHARIAH_TOOLS_PATH=/Volumes/Orico/code/capco/islamic-ai/shariah

# Redis (for caching, optional but recommended)
REDIS_URL=redis://localhost:6379
